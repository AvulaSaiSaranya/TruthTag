# These values are a local-development template, not production credentials.
TRUTHTAG_ENV=development
TRUTHTAG_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
TRUTHTAG_DB_PATH=./truthtag.db
TRUTHTAG_SEED_DEMO_DATA=true

# Optional comma-separated origins for a separately hosted frontend.
# Same-origin use does not require a CORS entry.
TRUTHTAG_CORS_ORIGINS=
